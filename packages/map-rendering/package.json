{
  "name": "@airpath/map-rendering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:deps": "pnpm --filter @airpath/shared-types build",
    "build": "tsc --project tsconfig.build.json",
    "lint": "pnpm run build:deps && tsc --project tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "pnpm run build:deps && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "pnpm run build:deps && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@airpath/shared-types": "workspace:*",
    "@deck.gl/layers": "^9.3.1"
  },
  "devDependencies": {}
}
