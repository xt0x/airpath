{
  "name": "@airpath/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:deps": "pnpm --filter @airpath/shared-types build",
    "build": "pnpm run build:deps && next build",
    "dev": "next dev",
    "lint": "pnpm run typecheck",
    "start": "next start",
    "test": "pnpm run build:deps && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "pnpm run build:deps && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@airpath/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "mapbox-gl": "^3.23.0",
    "next": "^16.0.10",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "recharts": "3.8.0",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4"
  }
}
