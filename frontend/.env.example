# Local web defaults. Never put FlightAware API keys, JWT signing material, or
# secret Mapbox tokens in browser-visible variables.
# Leave empty for same-origin /v1 API routes, or set an API origin such as
# https://api.example.com. Do not include the /v1 path prefix here.
NEXT_PUBLIC_API_BASE_URL=

# Public Mapbox token for the browser map. Use a publishable token only; never
# put secret Mapbox tokens or backend credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional Mapbox style URL. Leave empty to use mapbox://styles/mapbox/streets-v12.
NEXT_PUBLIC_MAPBOX_STYLE_URL=
