{
  "name": "airpath",
  "version": "0.1.0",
  "private": true,
  "description": "FlightAware AeroAPI 2D route display system",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "eslint": "eslint .",
    "format": "pnpm exec prettier --write \"**/*.{md,json,yml,yaml,ts,tsx,js,mjs,cjs}\"",
    "lint": "pnpm exec prettier --check \"**/*.{md,json,yml,yaml,ts,tsx,js,mjs,cjs}\" && pnpm exec eslint . && pnpm -r --if-present run lint",
    "test": "pnpm exec vitest run docs infra --passWithNoTests && pnpm -r --if-present run test",
    "test:watch": "pnpm -r --if-present run test:watch",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
